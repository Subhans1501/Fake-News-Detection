# =========================
# 📦 Data & Datasets
# =========================
# Ignore raw and processed data files to save bandwidth and respect licenses
data/*
!data/.gitkeep
*.csv
*.tsv
*.dat
*.zip
*.tar.gz

# =========================
# 🧠 Deep Learning Models
# =========================
# Ignore massive saved weights (should be hosted on Hugging Face or Google Drive)
*.h5
*.hdf5
*.keras
*.pkl
*.pt
*.pth
*.onnx
models/*
!models/.gitkeep
checkpoints/

# =========================
# 🐍 Python & Jupyter
# =========================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# =========================
# 🌐 Environments
# =========================
# Virtual environments and local environment variables
venv/
env/
.env
.venv
Pipfile.lock
requirements.txt.bak

# =========================
# 📊 Logs & Outputs
# =========================
# Ignore training logs (like TensorBoard)
logs/
*.log
runs/
wandb/

# =========================
# 💻 OS Generated Files
# =========================
# Mac
.DS_Store
._*

# Windows
Thumbs.db
ehthumbs.db